<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane prefHeight="720" prefWidth="1280" style="-fx-background-color: #494949;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se306.scheduler.gui.MainWindowController">
            
    <center>
        <StackPane
        fx:id="chartContainer"
        style="-fx-background-color: blue;" />
    </center>

    <bottom>
        <HBox
            alignment="CENTER"
            spacing="10"
            style="-fx-background-color: red;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Button
                fx:id="ganttButton"
                onAction="#showGanttChart"
                text="Gantt Chart" />

            <Button
                fx:id="treeButton"
                onAction="#showSearchTree"
                text="Search Tree" />
        </HBox>
    </bottom>

</BorderPane>
