<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane prefHeight="720" prefWidth="1280" style="-fx-background-color: #1e1e1d;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se306.scheduler.gui.MainWindowController">
            
    <center>
        <StackPane fx:id="chartContainer" style="-fx-background-color: transparent;" />
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: black;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <fx:define>
                <ToggleGroup fx:id="viewToggleGroup" />
            </fx:define>

            <ToggleButton fx:id="ganttButton" onAction="#showGanttChart" selected="true" stylesheets="@main-window.css" text="Gantt Chart">
            <toggleGroup>
               <ToggleGroup fx:id="viewToggleGroup" />
            </toggleGroup></ToggleButton>

            <ToggleButton fx:id="treeButton" onAction="#showSearchTree" stylesheets="@main-window.css" text="Search Tree" toggleGroup="$viewToggleGroup" />
        </HBox>
    </bottom>

</BorderPane>
